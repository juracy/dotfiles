[include]
	path = .gitconfig-personal

[core]
	autocrlf = input
	excludesfile = ~/.dotfiles/git/gitignore

[alias]
	branches = "for-each-ref --count=15 --sort=-committerdate --format=\"%(color:blue)%(authordate:relative)\t%(color:red)%(authorname)\t%(color:white)%(color:bold)%(refname:short)\" refs/heads"
	remote-branches = "for-each-ref --count=15 --sort=-committerdate --format=\"%(color:blue)%(authordate:relative)\t%(color:red)%(authorname)\t%(color:white)%(color:bold)%(refname:short)\" refs/remotes"
	ci = "commit -v"
	co = "checkout"
	dlog = -c diff.external=difft log --ext-diff
    dshow = -c diff.external=difft show --ext-diff
    ddiff = -c diff.external=difft diff
	diff-svg = "difftool -t lukaj -y"
	diff-pdf = "difftool -t diffpdf -y"
	dump = "cat-file -p"
	fdiff = "diff --name-only"
	fetchall = "fetch --all"
	hist = "log --pretty=format:'%h %ad | %s%d [%an]' --graph --date=short"
	idiff = "diff -w"
	last = "log -1 HEAD"
	lg = "!f() { NOTES=; git rev-parse --verify -q refs/notes/branches >/dev/null 2>&1 && NOTES=--notes=branches; git log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset %C(magenta)%N%Creset' --abbrev-commit $NOTES \"$@\"; }; f"
	sdiff = "diff --staged"
	slog = "log --pretty=format:'%h %ad | %s%d [%an]' --first-parent --date=local"
	st = "status"
	sw = "switch"
	tohead = "reset --hard HEAD"
	type = "cat-file -t"
	unstage = "reset HEAD --"
	untracked = "ls-files --others --exclude-standard"
	ff-merge = "!f() { git merge --ff-only \"$1\" && git notes --ref=branches add -m \"ff-merged-branch: $1\" HEAD; }; f"

[color]
	diff = auto
	status = auto
	branch = auto

[color "status"]
	changed = yellow
	added = green
	untracked = red

[push]
	default = simple

[merge]
	tool = meld
	conflictstyle = diff3

[lfs]
	contenttype = false

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f

[fetch]
	prune = true

[rebase]
	autosquash = true
	autoStash = true

[diff]
	tool = meld
	colorMoved = default

[pull]
	rebase = true

[init]
	defaultBranch = main

[interactive]
	diffFilter = delta --color-only

[add.interactive]
	useBuiltin = false # required for git 2.37.0

[delta]
	navigate = true    # use n and N to move between diff sections
	light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)

[http]
	postBuffer = 52428800

[user]
	name = Juracy Filho

[credential]
	helper = gopass

[diff "sqlite3"]
	command = gitsqldiff

[difftool "lukaj"]
	cmd = lukaj $LOCAL $REMOTE

[difftool "diffpdf"]
    cmd = diffpdf "$LOCAL" "$REMOTE"
